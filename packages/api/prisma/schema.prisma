generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Component {
  id       String            @id @default(uuid())
  category ComponentCategory
  label    String
  price    Float

  depth  Float?
  height Float?
  width  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

enum ComponentCategory {
  back
  baseCover
  foot
  leg
  misc
  shelf
  support
}
